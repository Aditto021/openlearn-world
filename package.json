{
  "name": "openlearn-world",
  "version": "1.0.0",
  "private": true,
  "description": "OpenLearn World: free, offline-aware learning without borders.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "vite",
    "build": "node scripts/clean-build.js && vite build",
    "seed:content": "node scripts/seed-content.js",
    "verify": "npm run build && npx tsc --noEmit && node --check server.js && node --check netlify/functions/api.js && node --check models/Content.js && node --check models/ContactSubmission.js && node --check models/PartnershipRequest.js && node --check models/User.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "google-auth-library": "^11.0.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.468.0",
    "mongoose": "^9.10.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1",
    "serverless-http": "^3.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
