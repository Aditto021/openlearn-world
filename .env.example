# Public frontend variables only. Never place server secrets in VITE_ variables.
VITE_TRANSLATION_PROVIDER=local
PORT=3000

# Server-only MongoDB Atlas variables. Never prefix these with VITE_.
MONGODB_URI=
MONGODB_DB_NAME=openlearn_world
SESSION_SECRET=generate-a-long-random-server-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
